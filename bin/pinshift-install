#!/usr/bin/env fish

set --local script_dir (path resolve (path dirname (status filename)))
source $script_dir/_pinshift-common.fish
or exit 1

pinshift_prepare_environment
or exit $status

set --local identifier dev.sayori.pinshift.controller
set --local install_root (path resolve .build/controller)
set --local install_bin $install_root/bin
set --local executable $install_bin/pinshift-controller
set --local requirement_file $install_root/designated-requirement
set --local source_file $install_root/source-fingerprint

set --local authority_label dev.sayori.pinshift.controller
set --local launch_agents_directory $HOME/Library/LaunchAgents
set --local authority_plist $launch_agents_directory/$authority_label.plist

set --local legacy_guardian_label dev.sayori.pinshift.cleanup-guardian
set --local legacy_guardian_plist $launch_agents_directory/$legacy_guardian_label.plist
set --local legacy_lifecycle_file $HOME/Library/Application\ Support/Pinshift/SimulationLifecycle/lifecycle.json
set --local legacy_pairing_code_file $HOME/Library/Application\ Support/Pinshift/ControllerLink/pairing-code
set --local user_id (id -u)

set --local generated_root (path resolve .build)
mkdir -p $generated_root
or exit 1
set --local staging_root (mktemp -d $generated_root/controller-install.XXXXXX)
or exit 1
set --local build_path $staging_root/build

swift build --configuration release --product pinshift-controller --build-path $build_path
or exit $status
set --local product_bin (swift build --configuration release --show-bin-path --build-path $build_path)
or exit $status
set --local candidate $staging_root/pinshift-controller
cp $product_bin/pinshift-controller $candidate
or exit $status
chmod 755 $candidate

set --local signing_identity
if set --query PINSHIFT_CODE_SIGN_IDENTITY; and test -n "$PINSHIFT_CODE_SIGN_IDENTITY"
    set signing_identity $PINSHIFT_CODE_SIGN_IDENTITY
else
    set --local identities (
        security find-identity -v -p codesigning |
        string match --regex --groups-only '^\s*\d+\) ([0-9A-F]{40}) '
    )
    if test (count $identities) -ne 1
        echo "Expected one valid code-signing identity. Set PINSHIFT_CODE_SIGN_IDENTITY privately." >&2
        exit 1
    end
    set signing_identity $identities[1]
end

codesign --force --sign $signing_identity --identifier $identifier --timestamp=none $candidate
or exit $status
codesign --verify --strict $candidate
or exit $status
set --local requirement (codesign -d -r- $candidate 2>&1 | string match -r '^designated => .*')
if test -z "$requirement"; or string match --quiet '*cdhash H*' $requirement
    echo "The candidate controller does not have a stable signing requirement." >&2
    exit 1
end
if not string match --quiet "*identifier \"$identifier\"*" $requirement
    echo "The candidate controller does not have the required identifier." >&2
    exit 1
end

# Stage every artifact before replacing the installed controller.
set --local source_fingerprint (pinshift_controller_source_fingerprint)
or exit $status
set --local staged_requirement $staging_root/designated-requirement
set --local staged_source $staging_root/source-fingerprint
printf '%s\n' $requirement > $staged_requirement
or exit $status
printf '%s\n' $source_fingerprint > $staged_source
or exit $status

if test -f $requirement_file
    set --local previous_requirement (string collect < $requirement_file)
    if test "$previous_requirement" != "$requirement"
        echo "The signing requirement changed. Existing Keychain trust was not modified." >&2
        exit 1
    end
end

mkdir -p $install_bin
or exit $status
set --local backup
if test -f $executable
    set backup $staging_root/previous-controller
    cp $executable $backup
    or exit $status
end
set --local requirement_backup
if test -f $requirement_file
    set requirement_backup $staging_root/previous-designated-requirement
    cp $requirement_file $requirement_backup
    or exit $status
end
set --local source_backup
if test -f $source_file
    set source_backup $staging_root/previous-source-fingerprint
    cp $source_file $source_backup
    or exit $status
end

function rollback_install --no-scope-shadowing
    set --local rollback_status 0
    if test -n "$backup"
        cp $backup $executable
        or set rollback_status $status
    else
        command rm -f -- $executable
        or set rollback_status $status
    end
    if test -n "$requirement_backup"
        cp $requirement_backup $requirement_file
        or set rollback_status $status
    else
        command rm -f -- $requirement_file
        or set rollback_status $status
    end
    if test -n "$source_backup"
        cp $source_backup $source_file
        or set rollback_status $status
    else
        command rm -f -- $source_file
        or set rollback_status $status
    end
    return $rollback_status
end

# Persistent authorities are deliberately retired. A test session owns one
# foreground controller process, started explicitly with pinshift-start.
if launchctl print gui/$user_id/$authority_label >/dev/null 2>&1
    launchctl bootout gui/$user_id/$authority_label
    or exit $status
end
if launchctl print gui/$user_id/$legacy_guardian_label >/dev/null 2>&1
    launchctl bootout gui/$user_id/$legacy_guardian_label
    or exit $status
end
command rm -f -- $authority_plist
or exit $status
command rm -f -- $legacy_guardian_plist
or exit $status

# Older pinshift-start versions kept `link serve` in a foreground terminal.
# Stop only processes owned by this user whose full command begins with the
# exact installed executable and subcommand; broad process-name killing is not
# safe enough for an installer.
set --local superseded_foreground_pids
for candidate_pid in (pgrep -u $user_id -f 'pinshift-controller link serve' 2>/dev/null)
    if not string match --quiet --regex '^[0-9]+$' -- $candidate_pid
        continue
    end
    set --local candidate_command (ps -p $candidate_pid -o command= 2>/dev/null | string trim)
    if string match --quiet "$executable link serve*" -- $candidate_command
        set --local parent_pid (ps -p $candidate_pid -o ppid= 2>/dev/null | string trim)
        if string match --quiet --regex '^[0-9]+$' -- $parent_pid
            set --local parent_command (ps -p $parent_pid -o command= 2>/dev/null | string trim)
            if string match --quiet "*$script_dir/pinshift-start*" -- $parent_command
                kill -TERM $parent_pid 2>/dev/null
                or if kill -0 $parent_pid 2>/dev/null
                    rollback_install
                    echo "The superseded pinshift-start wrapper could not be stopped safely." >&2
                    exit 1
                end
                set --append superseded_foreground_pids $parent_pid
            end
        end
        if kill -0 $candidate_pid 2>/dev/null
            kill -TERM $candidate_pid 2>/dev/null
            or if kill -0 $candidate_pid 2>/dev/null
                rollback_install
                echo "The superseded foreground controller could not be stopped safely." >&2
                exit 1
            end
            set --append superseded_foreground_pids $candidate_pid
        end
    end
end

for candidate_pid in $superseded_foreground_pids
    set --local did_exit 0
    for attempt in (seq 1 200)
        if not kill -0 $candidate_pid 2>/dev/null
            set did_exit 1
            break
        end
        sleep 0.1
    end
    if test $did_exit -ne 1
        rollback_install
        echo "A superseded foreground controller is still running. Close its old pinshift-start terminal and retry." >&2
        exit 1
    end
end

# Before discarding obsolete bookkeeping, use the signed candidate to perform
# one authoritative, idempotent backend clear. A failure stops the migration
# without publishing the new binary or claiming the old simulation is gone.
"$candidate" reset \
    --device "$PINSHIFT_DEVICE" \
    --developer-directory "$PINSHIFT_DEVELOPER_DIR"
or begin
    set --local failure_status $status
    echo "The persistent controller was removed, but its final Clear failed. Restore device connectivity and retry pinshift-install." >&2
    exit $failure_status
end
command rm -f -- $legacy_lifecycle_file
or exit $status
command rm -f -- $legacy_pairing_code_file
or exit $status

cp $candidate $executable
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end
chmod 755 $executable
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end
cp $staged_requirement $requirement_file
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end
cp $staged_source $source_file
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end

# Keychain authorization is the final fallible identity commit. It authorizes
# the foreground executable without registering a persistent process.
$executable link identity authorize-current-executable
set --local authorization_status $status
if test $authorization_status -ne 0
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    echo "Installation stopped without replacing the existing controller identity." >&2
    exit $authorization_status
end

set --local staging_name (path basename "$staging_root")
if test (path dirname "$staging_root") != (path resolve .build); or \
        not string match --quiet --regex '^controller-install\.[[:alnum:]]+$' "$staging_name"
    echo "The completed install staging path failed its cleanup safety check." >&2
    exit 1
end
command rm -rf -- "$staging_root"
or begin
    echo "The controller was installed, but its generated staging directory could not be removed." >&2
    exit 1
end

echo "Stable foreground controller installed. Run pinshift-start when testing."
