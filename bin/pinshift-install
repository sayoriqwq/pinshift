#!/usr/bin/env fish

set --local script_dir (path resolve (path dirname (status filename)))
source $script_dir/_pinshift-common.fish
or exit 1

pinshift_prepare_environment
or exit $status

set --local identifier dev.sayori.pinshift.controller
set --local install_root (path resolve .build/controller)
set --local install_bin $install_root/bin
set --local executable $install_bin/pinshift-controller
set --local requirement_file $install_root/designated-requirement
set --local source_file $install_root/source-fingerprint
set --local guardian_label dev.sayori.pinshift.cleanup-guardian
set --local guardian_template (path resolve Support/$guardian_label.plist)
set --local guardian_directory $HOME/Library/LaunchAgents
set --local guardian_plist $guardian_directory/$guardian_label.plist
set --local guardian_log_directory $HOME/Library/Logs/Pinshift
set --local guardian_log $guardian_log_directory/cleanup-guardian.log
set --local user_id (id -u)
set --local guardian_was_loaded 0
set --local guardian_restarted_after_rollback 0
set --local staging_root (mktemp -d .build/controller-install.XXXXXX)
or exit 1
set --local build_path $staging_root/build

swift build --configuration release --product pinshift-controller --build-path $build_path
or exit $status
set --local product_bin (swift build --configuration release --show-bin-path --build-path $build_path)
or exit $status
set --local candidate $staging_root/pinshift-controller
cp $product_bin/pinshift-controller $candidate
or exit $status
chmod 755 $candidate

set --local signing_identity
if set --query PINSHIFT_CODE_SIGN_IDENTITY; and test -n "$PINSHIFT_CODE_SIGN_IDENTITY"
    set signing_identity $PINSHIFT_CODE_SIGN_IDENTITY
else
    set --local identities (
        security find-identity -v -p codesigning |
        string match --regex --groups-only '^\s*\d+\) ([0-9A-F]{40}) '
    )
    if test (count $identities) -ne 1
        echo "Expected one valid code-signing identity. Set PINSHIFT_CODE_SIGN_IDENTITY privately." >&2
        exit 1
    end
    set signing_identity $identities[1]
end

codesign --force --sign $signing_identity --identifier $identifier --timestamp=none $candidate
or exit $status
codesign --verify --strict $candidate
or exit $status
set --local requirement (codesign -d -r- $candidate 2>&1 | string match -r '^designated => .*')
if test -z "$requirement"; or string match --quiet '*cdhash H*' $requirement
    echo "The candidate controller does not have a stable signing requirement." >&2
    exit 1
end
if not string match --quiet "*identifier \"$identifier\"*" $requirement
    echo "The candidate controller does not have the required identifier." >&2
    exit 1
end

# Compute and stage every piece of metadata before replacing the installed controller.
set --local source_fingerprint (pinshift_controller_source_fingerprint)
or exit $status
set --local staged_requirement $staging_root/designated-requirement
set --local staged_source $staging_root/source-fingerprint
set --local staged_guardian $staging_root/$guardian_label.plist
printf '%s\n' $requirement > $staged_requirement
or exit $status
printf '%s\n' $source_fingerprint > $staged_source
or exit $status
cp $guardian_template $staged_guardian
or exit $status
plutil -remove ProgramArguments.0 $staged_guardian
or exit $status
plutil -insert ProgramArguments.0 -string $executable $staged_guardian
or exit $status
plutil -remove ProgramArguments.3 $staged_guardian
or exit $status
plutil -insert ProgramArguments.3 -string $PINSHIFT_DEVICE $staged_guardian
or exit $status
plutil -remove ProgramArguments.5 $staged_guardian
or exit $status
plutil -insert ProgramArguments.5 -string $PINSHIFT_DEVELOPER_DIR $staged_guardian
or exit $status
plutil -replace StandardOutPath -string $guardian_log $staged_guardian
or exit $status
plutil -replace StandardErrorPath -string $guardian_log $staged_guardian
or exit $status
plutil -lint $staged_guardian
or exit $status

if test -f $requirement_file
    set --local previous_requirement (string collect < $requirement_file)
    if test "$previous_requirement" != "$requirement"
        echo "The signing requirement changed. Existing Keychain trust was not modified." >&2
        exit 1
    end
end

mkdir -p $install_bin
or exit $status
set --local backup
if test -f $executable
    set backup $staging_root/previous-controller
    cp $executable $backup
    or exit $status
end
set --local requirement_backup
if test -f $requirement_file
    set requirement_backup $staging_root/previous-designated-requirement
    cp $requirement_file $requirement_backup
    or exit $status
end
set --local source_backup
if test -f $source_file
    set source_backup $staging_root/previous-source-fingerprint
    cp $source_file $source_backup
    or exit $status
end

function rollback_install --no-scope-shadowing
    set --local rollback_status 0
    if test -n "$backup"
        cp $backup $executable
        or set rollback_status $status
    else
        command rm -f -- $executable
        or set rollback_status $status
    end
    if test -n "$requirement_backup"
        cp $requirement_backup $requirement_file
        or set rollback_status $status
    else
        command rm -f -- $requirement_file
        or set rollback_status $status
    end
    if test -n "$source_backup"
        cp $source_backup $source_file
        or set rollback_status $status
    else
        command rm -f -- $source_file
        or set rollback_status $status
    end
    if test $guardian_was_loaded -eq 1; and test $guardian_restarted_after_rollback -eq 0
        launchctl bootstrap gui/$user_id $guardian_plist
        or set rollback_status $status
        if test $rollback_status -eq 0
            set guardian_restarted_after_rollback 1
        end
    end
    return $rollback_status
end

# A running process cannot safely share an executable path while that signed
# executable is replaced. Stop only this exact LaunchAgent and restore it from
# rollback_install if any later install step fails.
if launchctl print gui/$user_id/$guardian_label >/dev/null 2>&1
    set guardian_was_loaded 1
    launchctl bootout gui/$user_id/$guardian_label
    or exit $status
end

cp $candidate $executable
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end
chmod 755 $executable
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end

cp $staged_requirement $requirement_file
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end
cp $staged_source $source_file
or begin
    set --local failure_status $status
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    exit $failure_status
end

# Keychain authorization is the final fallible commit. Every filesystem artifact is
# already published and can be restored if authorization declines or fails.
$executable link identity authorize-current-executable
set --local authorization_status $status
if test $authorization_status -ne 0
    rollback_install
    or echo "Installation rollback failed; inspect $install_root before retrying." >&2
    echo "Installation stopped without replacing the existing controller identity." >&2
    exit $authorization_status
end

# Cleanup ownership must outlive the foreground Controller Link. Publish the
# per-user LaunchAgent only after the signed executable and Keychain ACL commit.
mkdir -p $guardian_directory $guardian_log_directory
or exit $status
cp $staged_guardian $guardian_plist
or exit $status
chmod 600 $guardian_plist
or exit $status
launchctl bootout gui/$user_id/$guardian_label >/dev/null 2>&1
launchctl bootstrap gui/$user_id $guardian_plist
or begin
    echo "The controller was installed, but the Cleanup Guardian could not be registered." >&2
    echo "Run pinshift-install again before applying another Simulated Location." >&2
    exit 1
end
launchctl kickstart -k gui/$user_id/$guardian_label
or begin
    echo "The Cleanup Guardian was registered but did not start." >&2
    exit 1
end

set --local staging_name (path basename "$staging_root")
if test (path dirname "$staging_root") != (path resolve .build); or \
        not string match --quiet --regex '^controller-install\.[[:alnum:]]+$' "$staging_name"
    echo "The completed install staging path failed its cleanup safety check." >&2
    exit 1
end
command rm -rf -- "$staging_root"
or begin
    echo "The controller was installed, but its generated staging directory could not be removed." >&2
    exit 1
end

echo "Stable controller and persistent Cleanup Guardian installed. Daily pinshift-start, pinshift-doctor, and pinshift-reset are ready."
