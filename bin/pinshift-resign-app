#!/usr/bin/env fish

set --local script_dir (path resolve (path dirname (status filename)))
source $script_dir/_pinshift-common.fish
or exit 1
source $script_dir/_pinshift-app-signing.fish
or exit 1

argparse h/help f/force no-launch launch-only -- $argv
or exit 2

if set --query _flag_help
    echo "Usage: pinshift-resign-app [--force] [--no-launch] [--launch-only]"
    echo "Renews, verifies, and installs the Personal Team-signed Pinshift app."
    echo "By default, renewal is skipped while more than 24 hours remain."
    exit 0
end

if set --query _flag_launch_only; and begin
        set --query _flag_force
        or set --query _flag_no_launch
    end
    echo "--launch-only cannot be combined with --force or --no-launch." >&2
    exit 2
end

pinshift_prepare_environment
or exit $status

set --local bundle_identifier dev.sayori.pinshift
set --local project Pinshift.xcodeproj
set --local scheme Pinshift
set --local renewal_threshold_seconds (math '24 * 60 * 60')

set --local work_root (path resolve .build)
if set --query PINSHIFT_RESIGN_WORK_ROOT
    set work_root (path resolve "$PINSHIFT_RESIGN_WORK_ROOT")
end
mkdir -p "$work_root"
or exit $status
if test -L "$work_root"
    echo "The resign work directory must not be a symbolic link." >&2
    exit 1
end

set --local lock_directory "$work_root/pinshift-resign.lock"
mkdir "$lock_directory" 2>/dev/null
or begin
    echo "Another pinshift-resign-app process may be running. No signing state was changed." >&2
    exit 1
end

set --local staging_root (mktemp -d "$work_root/pinshift-resign-staging.XXXXXX")
or begin
    command rmdir "$lock_directory" 2>/dev/null
    exit 1
end
chmod 700 "$staging_root"
or exit $status

set --global _pinshift_resign_work_root "$work_root"
set --global _pinshift_resign_staging_root "$staging_root"
set --global _pinshift_resign_lock_directory "$lock_directory"
set --global _pinshift_resign_profiles_committed 0
set --global _pinshift_resign_preserve_staging 0
set --erase _pinshift_resign_moved_sources
set --erase _pinshift_resign_moved_backups
set --erase _pinshift_resign_backup_directory

if set --query _flag_launch_only
    pinshift_launch_pinshift_app "$PINSHIFT_DEVICE" "$bundle_identifier" "$staging_root"
    exit $status
end

# An unconfirmed install must be resumed before considering the fresh-profile cache.
# Only names within this work directory are persisted; no shell code or arbitrary path is loaded.
set --local pending_install "$work_root/pinshift-pending-install.json"
set --local resuming_install 0
set --local old_team_identifier
set --local old_application_prefix
set --local old_max_expiration_epoch 0
set --local backup_directory
set --local now_epoch (/bin/date '+%s')
if test -e "$pending_install"; or test -L "$pending_install"
    if not test -f "$pending_install"; or test -L "$pending_install"; or not jq --exit-status '
        .version == 1
        and (.staging | type == "string" and test("^pinshift-resign-staging[.][A-Za-z0-9]+$"))
        and (.backup | type == "string" and test("^session[.][A-Za-z0-9]+$"))
        and (.device | type == "string" and length > 0 and (contains("\n") | not))
        and (.team | type == "string" and test("^[A-Za-z0-9]+$"))
        and (.prefix | type == "string" and test("^[A-Za-z0-9]+$"))
        and (.previousExpiry | type == "number")
        and (.expiry | type == "number")
    ' "$pending_install" >/dev/null 2>&1
        echo "The pending app installation record is invalid; no signing or installation state was changed." >&2
        exit 1
    end
    set --local pending_values (jq --raw-output '.staging, .backup, .device, .team, .prefix, .previousExpiry, .expiry' "$pending_install")
    if test "$pending_values[3]" != "$PINSHIFT_DEVICE"
        echo "An app installation is pending for a different iPhone. Reconnect the original Active Test Device and retry pinshift." >&2
        exit 1
    end
    if set --query _flag_force
        echo "A forced rebuild supersedes the pending installation. Keeping its files and building the current source."
    else if test "$pending_values[7]" -le "$now_epoch"
        echo "The pending app build has expired. Keeping its files and requesting a fresh build."
    else
        set --local pending_staging "$work_root/$pending_values[1]"
        set backup_directory "$work_root/resign-profile-backups/$pending_values[2]"
        if not test -d "$pending_staging"; or test -L "$pending_staging"; or not test -d "$backup_directory"; or test -L "$backup_directory"
            echo "The pending app installation files are missing or unsafe; no app was installed." >&2
            exit 1
        end
        command rmdir "$staging_root"
        or exit $status
        set staging_root "$pending_staging"
        set old_team_identifier "$pending_values[4]"
        set old_application_prefix "$pending_values[5]"
        set old_max_expiration_epoch "$pending_values[6]"
        set resuming_install 1
        set --global _pinshift_resign_staging_root "$staging_root"
        set --global _pinshift_resign_backup_directory "$backup_directory"
        set --global _pinshift_resign_profiles_committed 1
        set --global _pinshift_resign_preserve_staging 1
        echo "Resuming the unconfirmed Pinshift installation; revalidating the preserved app first."
    end
end

set --local derived_data "$staging_root/DerivedData"
if test $resuming_install -eq 0
    set --local profile_directories \
        "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles" \
        "$HOME/Library/MobileDevice/Provisioning Profiles"
    if set --query PINSHIFT_PROVISIONING_PROFILE_DIRECTORY
        set profile_directories "$PINSHIFT_PROVISIONING_PROFILE_DIRECTORY"
    end
    set --global _pinshift_resign_profile_directories $profile_directories
    set --global _pinshift_resign_bundle_identifier "$bundle_identifier"

    set --local matched_profiles
    set --local profile_index 0

    for profile_directory in $profile_directories
        if not test -d "$profile_directory"
            continue
        end
        if test -L "$profile_directory"
            echo "A provisioning-profile directory is a symbolic link; refusing to modify it." >&2
            exit 1
        end

        set --local cached_profiles (
            find "$profile_directory" -maxdepth 1 -name '*.mobileprovision'
        )
        or begin
            echo "A provisioning-profile directory could not be inspected." >&2
            exit 1
        end

        for profile in $cached_profiles
            if test -L "$profile"
                echo "A cached provisioning profile is a symbolic link; refusing to modify it." >&2
                exit 1
            end
            if not test -f "$profile"
                continue
            end

            set profile_index (math $profile_index + 1)
            set --local decoded "$staging_root/cached-profile-$profile_index.plist"
            pinshift_decode_mobileprovision "$profile" "$decoded"
            or begin
                echo "A cached provisioning profile could not be decoded. No signing state was changed." >&2
                exit 1
            end

            if not pinshift_decoded_profile_is_ios_app "$decoded" "$bundle_identifier"
                continue
            end

            set --local team_identifier (pinshift_plist_raw "$decoded" TeamIdentifier.0)
            or exit 1
            set --local application_prefix (
                pinshift_plist_raw "$decoded" ApplicationIdentifierPrefix.0
            )
            or exit 1
            set --local expiration (pinshift_plist_raw "$decoded" ExpirationDate)
            or exit 1
            set --local expiration_epoch (pinshift_iso8601_epoch "$expiration")
            or begin
                echo "A matching provisioning profile has an invalid expiration date." >&2
                exit 1
            end

            if test -n "$old_team_identifier"; and test "$team_identifier" != "$old_team_identifier"
                echo "Matching profiles disagree about the development team; refusing to renew." >&2
                exit 1
            end
            if test -n "$old_application_prefix"; and test "$application_prefix" != "$old_application_prefix"
                echo "Matching profiles disagree about the application prefix; refusing to renew." >&2
                exit 1
            end

            set old_team_identifier "$team_identifier"
            set old_application_prefix "$application_prefix"
            set --append matched_profiles "$profile"
            if test $expiration_epoch -gt $old_max_expiration_epoch
                set old_max_expiration_epoch $expiration_epoch
            end
        end
    end

    if test (count $matched_profiles) -eq 0
        echo "No existing Pinshift app profile was found." >&2
        echo "Open Pinshift.xcodeproj in Xcode, sign in under Settings → Apple Accounts, and select your team in Signing & Capabilities." >&2
        echo "Connect and unlock the iPhone, accept Trust This Computer, enable Developer Mode if requested, then run Pinshift once from Xcode." >&2
        exit 1
    end

    set --local remaining_seconds (math "$old_max_expiration_epoch - $now_epoch")
    if not set --query _flag_force; and test $remaining_seconds -gt $renewal_threshold_seconds
        echo "The cached Pinshift signing profile expires at "(pinshift_local_expiration $old_max_expiration_epoch)"."
        echo "More than 24 hours remain; skipping renewal. This cache does not verify installation on the iPhone."
        echo "Open Pinshift on the iPhone to confirm it is usable."
        exit 0
    end

    set --local backup_parent "$work_root/resign-profile-backups"
    mkdir -p "$backup_parent"
    or exit $status
    set backup_directory (mktemp -d "$backup_parent/session.XXXXXX")
    or exit $status
    chmod 700 "$backup_directory"
    or exit $status
    set --global _pinshift_resign_backup_directory "$backup_directory"

    set --local move_index 0
    for profile in $matched_profiles
        set move_index (math $move_index + 1)
        set --local backup_path "$backup_directory/$move_index-"(path basename "$profile")
        mv "$profile" "$backup_path"
        or exit $status
        set --global --append _pinshift_resign_moved_sources "$profile"
        set --global --append _pinshift_resign_moved_backups "$backup_path"
    end

    echo "Requesting a new Personal Team provisioning profile from Xcode…"
    set --local build_log "$staging_root/xcodebuild.log"
    xcodebuild \
        -project "$project" \
        -scheme "$scheme" \
        -configuration Debug \
        -destination 'generic/platform=iOS' \
        -derivedDataPath "$derived_data" \
        -allowProvisioningUpdates \
        -allowProvisioningDeviceRegistration \
        DEVELOPMENT_TEAM="$old_team_identifier" \
        build >"$build_log" 2>&1
    set --local build_status $status
    if test $build_status -ne 0
        cp "$build_log" "$backup_directory/xcodebuild.log"
        chmod 600 "$backup_directory/xcodebuild.log"
        if string match --quiet --regex 'No Accounts|Add a new account|Unable to log in|Authentication|session.*expired' -- (string collect <"$build_log")
            echo "Xcode could not authenticate the Apple Account. Sign in again under Xcode → Settings → Apple Accounts." >&2
        else
            echo "Xcode could not create a renewed app build." >&2
        end
        echo "Check Xcode → Settings → Apple Accounts and Signing & Capabilities, then retry `pinshift`." >&2
        echo "The old profile will be restored; details are kept in the local backup directory." >&2
        exit $build_status
    end

end

set --local candidate \
    "$derived_data/Build/Products/Debug-iphoneos/Pinshift.app"
set --local embedded_profile "$candidate/embedded.mobileprovision"
set --local info_plist "$candidate/Info.plist"
if not test -d "$candidate"; or not test -f "$embedded_profile"; or not test -f "$info_plist"
    echo "Xcode reported success but did not produce the expected signed app." >&2
    exit 1
end

codesign --verify --deep --strict "$candidate" >/dev/null 2>&1
or begin
    echo "The candidate app failed code-signature verification and will not be installed." >&2
    exit 1
end

set --local candidate_bundle_identifier (pinshift_plist_raw "$info_plist" CFBundleIdentifier)
or exit 1
if test "$candidate_bundle_identifier" != "$bundle_identifier"
    echo "The candidate app has an unexpected bundle identifier and will not be installed." >&2
    exit 1
end

set --local decoded_candidate "$staging_root/candidate-profile.plist"
pinshift_decode_mobileprovision "$embedded_profile" "$decoded_candidate"
or begin
    echo "The candidate provisioning profile could not be decoded." >&2
    exit 1
end
pinshift_decoded_profile_is_ios_app "$decoded_candidate" "$bundle_identifier"
or begin
    echo "The candidate profile does not authorize the Pinshift iOS app." >&2
    exit 1
end

set --local new_team_identifier (pinshift_plist_raw "$decoded_candidate" TeamIdentifier.0)
or exit 1
set --local new_application_prefix (
    pinshift_plist_raw "$decoded_candidate" ApplicationIdentifierPrefix.0
)
or exit 1
if test "$new_team_identifier" != "$old_team_identifier"; or test "$new_application_prefix" != "$old_application_prefix"
    echo "The renewed profile changed the app signing identity and will not be installed." >&2
    exit 1
end

set --local new_expiration (pinshift_plist_raw "$decoded_candidate" ExpirationDate)
or exit 1
set --local new_expiration_epoch (pinshift_iso8601_epoch "$new_expiration")
or begin
    echo "The renewed profile has an invalid expiration date." >&2
    exit 1
end
if test $new_expiration_epoch -le $now_epoch; or test $new_expiration_epoch -le $old_max_expiration_epoch
    echo "Xcode did not advance the provisioning-profile expiration date." >&2
    echo "The candidate app will not be installed, and the old profile will be restored." >&2
    exit 1
end

echo "New signature verified through "(pinshift_local_expiration $new_expiration_epoch)"."
set --local install_json "$staging_root/install.json"
set --local install_log "$staging_root/install.log"
# Publish recovery state before starting a device operation whose outcome may be lost.
set --local pending_staged "$staging_root/pending-install.json"
jq --null-input \
    --arg staging (path basename "$staging_root") \
    --arg backup (path basename "$backup_directory") \
    --arg device "$PINSHIFT_DEVICE" \
    --arg team "$old_team_identifier" \
    --arg prefix "$old_application_prefix" \
    --argjson previousExpiry "$old_max_expiration_epoch" \
    --argjson expiry "$new_expiration_epoch" \
    '{version: 1, staging: $staging, backup: $backup, device: $device, team: $team, prefix: $prefix, previousExpiry: $previousExpiry, expiry: $expiry}' >"$pending_staged"
or exit $status
chmod 600 "$pending_staged"
or exit $status
mv "$pending_staged" "$pending_install"
or exit $status
set --global _pinshift_resign_profiles_committed 1
set --global _pinshift_resign_preserve_staging 1
# An earlier failed invocation may have left a successful-looking JSON result behind.
command rm -f -- "$install_json"
or exit $status
xcrun devicectl device install app \
    --quiet \
    --timeout 120 \
    --device "$PINSHIFT_DEVICE" \
    --json-output "$install_json" \
    "$candidate" >"$install_log" 2>&1
set --local install_status $status
if test $install_status -ne 0
    cp "$install_log" "$backup_directory/install.log"
    chmod 600 "$backup_directory/install.log"
    echo "The device did not provide a confirmed installation result." >&2
    echo "Connect and unlock the iPhone, accept Trust This Computer and Developer Mode prompts, then retry `pinshift`." >&2
    echo "The phone may or may not contain the renewed app, so the new profile and candidate were preserved." >&2
    echo "The next `pinshift` resumes this installation. Private details are kept at $staging_root." >&2
    exit $install_status
end
if not test -f "$install_json"; or not jq --exit-status '.info.outcome == "success"' "$install_json" >/dev/null 2>&1
    echo "The device command returned success, but its installation result could not be verified." >&2
    echo "Reconnect and unlock the iPhone, then run `pinshift` to resume this installation." >&2
    echo "The new profile and candidate were preserved at $staging_root." >&2
    exit 1
end

command rm -- "$pending_install"
or exit $status
set --global _pinshift_resign_preserve_staging 0
echo "The renewed Pinshift app was installed without uninstalling the existing app."

if not set --query _flag_no_launch
    pinshift_launch_pinshift_app "$PINSHIFT_DEVICE" "$bundle_identifier" "$staging_root"
    or exit $status
end

echo "Previous app profiles were archived at $backup_directory."
