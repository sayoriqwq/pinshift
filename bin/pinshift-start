#!/usr/bin/env fish

set --local script_dir (path resolve (path dirname (status filename)))
source $script_dir/_pinshift-common.fish
or exit 1

# Keep the wrapper alive when the foreground controller receives Control-C so
# the abnormal-exit reset below can run.
function pinshift_keep_wrapper_for_cleanup --on-signal INT
end

argparse 'h/help' 's/seconds=' 'l/lease-seconds=' -- $argv
or exit 2

if set --query _flag_help
    echo "Usage: pinshift-start [--seconds 60...86400] [--lease-seconds 30...3600]"
    echo "Starts the trusted Controller Link and keeps it open. Stop with Ctrl+C."
    echo "The Pinshift app starts each Applied Simulation with 15 minutes by default."
    exit 0
end

pinshift_prepare_environment
or exit $status
set --local controller (pinshift_controller_executable)
or exit $status

set --local seconds 3600
if set --query PINSHIFT_SECONDS
    set seconds $PINSHIFT_SECONDS
end
if set --query _flag_seconds
    set seconds $_flag_seconds
end

set --local lease_seconds
if set --query PINSHIFT_LEASE_SECONDS
    set lease_seconds $PINSHIFT_LEASE_SECONDS
end
if set --query _flag_lease_seconds
    set lease_seconds $_flag_lease_seconds
end

set --local serve_arguments link serve --seconds $seconds
if set --query lease_seconds[1]
    set --append serve_arguments --lease-seconds $lease_seconds
end

$controller $serve_arguments
set --local serve_status $status

# Normal expiry already performs cleanup inside the controller. A signal or other
# abnormal exit may bypass that lifecycle, so make the reset explicit and idempotent.
if test $serve_status -ne 0
    $controller reset
end

exit $serve_status
